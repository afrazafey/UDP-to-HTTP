# The CLI reads process environment; it does not automatically read .env files.
UDPHTTP_CONFIG=configs/config.example.yaml
UDPHTTP_STORAGE_PATH=data/udphttp-proxy.db
UDPHTTP_LOG_LEVEL=info
# Recovery only: ignore persisted server settings for this process; keep the DB intact.
UDPHTTP_IGNORE_SAVED_SETTINGS=0
